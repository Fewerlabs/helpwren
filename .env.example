# Copy to apps/web/.env.local and adjust. Every variable is validated at startup by the Zod
# schema in apps/web/src/lib/env.ts; add new variables there and here in the same change.
#
# For local development, `pnpm db:env` writes apps/web/.env.local for you, with the addresses
# and keys of the local Supabase stack.

# The public address of this install. Used for canonical URLs and the generated widget snippet.
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Supabase project this install stores its data in. Required.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase's publishable key. Safe in the browser: the access rules decide what it can do.
# Required. `pnpm db:status` prints the local one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Supabase's secret key, which bypasses the access rules. Never give it a NEXT_PUBLIC_ name and
# never send it to a browser. Only `pnpm agent:invite` reads it so far.
SUPABASE_SECRET_KEY=replace-with-your-secret-key
