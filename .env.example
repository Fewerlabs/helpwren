# Copy to apps/web/.env.local and adjust. Every variable is validated at startup by the Zod
# schema in apps/web/src/lib/env.ts; add new variables there and here in the same change.
#
# For local development, `pnpm db:env` writes apps/web/.env.local for you, with the addresses
# and keys of the local Supabase stack.

# The public address of this install. Used for canonical URLs and the generated widget snippet.
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Supabase project this install stores its data in. Required.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase's publishable key. Safe in the browser: the access rules decide what it can do.
# Required. `pnpm db:status` prints the local one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Supabase's secret key, which bypasses the access rules. Never give it a NEXT_PUBLIC_ name and
# never send it to a browser. Required: the server uses it for what the access rules leave to
# it, such as starting a conversation.
SUPABASE_SECRET_KEY=replace-with-your-secret-key

# How this install sends email. Leave everything below unset to enter an SMTP server in the
# dashboard instead, under Settings → Email. Values set here win over the dashboard.
EMAIL_PROVIDER=

# An SMTP server, with the values exactly as your mail provider gives them. No encoding needed.
SMTP_HOST=
# 587 (the default) upgrades with STARTTLS; 465 uses TLS from the start.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Or the same in one address. Characters such as @ # / ? in it must be percent-encoded.
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=

# For EMAIL_PROVIDER=resend: an API key from https://resend.com that may send.
RESEND_API_KEY=

# A long random value a scheduler presents to run timed work: `POST /api/jobs/email` every
# minute sends the emails that are due. Leave unset to have no scheduled work.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Where request counts for the rate limits are kept: `database` (the default) shares one count
# between every copy of the app; `memory` keeps one per process, enough for a single server.
RATE_LIMIT_STORE=

# The header holding the visitor's network address, as your proxy sets it. The last address in
# it is used. Default: x-forwarded-for. Behind Cloudflare: cf-connecting-ip.
CLIENT_IP_HEADER=

# Cloudflare Turnstile's secret key. The captcha is switched on, with its site key, under
# Settings → General; without this key it stays off.
TURNSTILE_SECRET_KEY=

# Where the server reaches Supabase, when that is not the public address above: beside a
# self-hosted Supabase in Docker, its gateway on the private network, such as http://kong:8000.
# Leave unset everywhere else. deploy/docker/docker-compose.yml sets it for you.
SUPABASE_INTERNAL_URL=
