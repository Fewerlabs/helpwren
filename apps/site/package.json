    "capture": "node scripts/capture.mjs",
    "check:wren": "node scripts/overlap-check.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@helpwren/design-system": "workspace:*",
    "fumadocs-core": "^16.19.4",
