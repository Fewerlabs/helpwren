    "fumadocs-ui": "^16.19.4",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "^16.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@helpwren/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "catalog:",
    "github-slugger": "^2.0.0",
    "jsdom": "^31.0.1",
    "mdast-util-mdx-jsx": "^3.2.1",
    "playwright": "^1.65.1",
    "sharp": "0.35.5",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
