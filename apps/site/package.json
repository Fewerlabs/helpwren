  "private": true,
  "description": "The Helpwren website at helpwren.fewerlabs.dev: a scroll-driven field journal.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build && node scripts/check-docs-links.mjs",
    "start": "next start --port 3210",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
