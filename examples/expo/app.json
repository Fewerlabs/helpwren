{
  "expo": {
    "name": "Helpwren example",
    "slug": "helpwren-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.fewerlabs.helpwren.example",
      "infoPlist": {
        "NSCameraUsageDescription": "To send a photo to support.",
        "NSPhotoLibraryUsageDescription": "To send a photo to support.",
        "NSMicrophoneUsageDescription": "To record a video for support."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.fewerlabs.helpwren.example",
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-status-bar"]
  }
}
