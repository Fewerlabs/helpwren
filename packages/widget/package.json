{
  "name": "helpwren",
  "version": "0.0.0",
  "private": true,
  "description": "The embeddable Helpwren widget script loaded by host sites.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/widget.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/widget.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@helpwren/config": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "jsdom": "^31.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
